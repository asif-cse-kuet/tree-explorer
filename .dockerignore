# Docker ignore file - exclude unnecessary files from Docker context

# Node modules
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist
dist-ssr
*.local

# Editor directories and files
.vscode
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# Git
.git
.gitignore
.gitattributes

# Documentation
README.md
CHANGELOG.md
docs/

# Testing
coverage
.nyc_output
*.test.js
*.spec.js
__tests__
__mocks__

# CI/CD
.github
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml

# Environment files
.env.local
.env.*.local
.env.development
.env.staging

# Logs
logs
*.log

# OS
Thumbs.db
.DS_Store

# Docker files (no need to copy into container)
Dockerfile*
docker-compose*.yml
.dockerignore
